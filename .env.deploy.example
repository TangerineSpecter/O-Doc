IMAGE_NAME=ghcr.io/tangerinespecter/o-doc:latest
CONTAINER_NAME=o-doc
HOST_PORT=11800

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*

ADMIN_EMAIL=admin@example.com

POSTGRES_CONTAINER_NAME=o-doc-postgres
POSTGRES_IMAGE=m.daocloud.io/docker.io/postgres:16-alpine
POSTGRES_DB=odoc
POSTGRES_USER=odoc
POSTGRES_PASSWORD=change-me
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_HOST_PORT=15432

# 战斗事实保留天数；0 表示关闭每日检查点与归档
ODOC_COMBAT_ARCHIVE_DAYS=7
