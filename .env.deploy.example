IMAGE_NAME=ghcr.io/tangerinespecter/o-doc:latest
CONTAINER_NAME=o-doc
HOST_PORT=11800

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*

ADMIN_EMAIL=admin@example.com

POSTGRES_CONTAINER_NAME=o-doc-postgres
POSTGRES_IMAGE=m.daocloud.io/docker.io/postgres:16-alpine
POSTGRES_DB=odoc
POSTGRES_USER=odoc
POSTGRES_PASSWORD=change-me
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_HOST_PORT=15432

# 旧战斗归档已停用；此配置不会启用旧版删除。
ODOC_COMBAT_ARCHIVE_DAYS=0

# 组队和旧单人战斗统计自动分批生成，积压处理完后每五分钟检查。
# 全部已结束来源核验完成后自动清理七天前的回合；设为 0 可暂停统计和清理。
ODOC_COMBAT_DAILY_AUTO=1

# 受保护的手工回填工具和钓鱼历史回填仍默认关闭。
ODOC_COMBAT_BACKFILL_PROTECT=0
ODOC_COMBAT_DAILY_BACKFILL=0
ODOC_FISHING_DAILY_BACKFILL=0
