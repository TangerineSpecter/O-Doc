# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
package-lock.json
db.sqlite3
chroma_data/*

# 忽略迁移目录中的缓存，但保留 Django 迁移文件
**/migrations/*
!**/migrations/__init__.py
!**/migrations/[0-9][0-9][0-9][0-9]_*.py

# Python compiled cache
# 忽略所有 __pycache__ 目录
__pycache__/
# 忽略所有 .pyc 文件（包括任何目录下的）
*.pyc
# 额外覆盖 Python 版本相关的字节码文件（如 .cpython-311.pyc）
*.cpython-*.pyc
*.py[cod]
*$py.class

# Build outputs (generated files)
templates/index.html
static/*
staticfiles/*
media/*
deploy/runtime/*
.env.deploy
.env.tcr.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.trae/
